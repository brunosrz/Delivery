{
  "name": "@delivery/casa-das-maquinas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "openapi:export": "node --experimental-transform-types scripts/openapi-export.mjs",
    "cf-typegen": "wrangler types --strict-vars=false src/worker-configuration.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run",
    "e2e:serve": "node scripts/e2e-serve.mjs"
  },
  "dependencies": {
    "@delivery/contracts": "workspace:*",
    "@delivery/domain": "workspace:*",
    "@hono/zod-openapi": "1.6.3",
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.11",
    "@eslint/js": "9.39.5",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12",
    "wrangler": "4.156.0"
  }
}
