{
  "name": "delivery",
  "version": "0.1.1",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "unrs-resolver",
    "workerd"
  ],
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "bun run --filter @delivery/web dev",
    "build": "bun run --filter @delivery/web build",
    "start": "bun run --filter @delivery/web start",
    "lint": "bun run --filter '*' lint",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "test:coverage": "bun run --filter '*' test:coverage",
    "check:boundaries": "node scripts/check-import-boundaries.mjs && node --test \"scripts/tests/*.test.mjs\"",
    "e2e": "bun run --filter @delivery/web e2e"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
