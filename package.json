{
  "name": "delivery",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @delivery/web dev",
    "build": "pnpm --filter @delivery/web build",
    "start": "pnpm --filter @delivery/web start",
    "lint": "pnpm -r lint",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "check:boundaries": "node scripts/check-import-boundaries.mjs && node --test scripts/tests/",
    "e2e": "pnpm --filter @delivery/web e2e"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
