# Cadastre estes nomes como Actions secrets em Settings > Secrets and variables > Actions.
# CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID, D1_DATABASE_ID e os VERCEL_*
# devem estar disponíveis no environment Production, usado pelo deploy.yml.
# RELEASE_PLEASE_TOKEN é opcional e pode ser cadastrado como repository secret.

# Deploy do Worker/D1 na Cloudflare
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_ID=

# Deploy do app web na Vercel
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Opcional: permite que PRs de release criadas pelo Release Please
# disparem os workflows de CI automaticamente.
RELEASE_PLEASE_TOKEN=
