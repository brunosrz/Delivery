# Cadastre estes secrets separadamente nos GitHub Environments Preview e
# Production. As credenciais da conta podem ser compartilhadas com ERP/PDV;
# D1_DATABASE_ID é exclusivo do Delivery e muda por ambiente.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_ID=7e64fb05-d729-4aae-9ff0-425831b69a31 # Preview
