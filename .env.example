# Copie para .env (ignorado pelo Git) e preencha os segredos usando os valores
# compartilhados com o ERP/PDV. Os IDs D1 abaixo são exclusivos do Delivery.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
PREVIEW_D1_DATABASE_ID=7e64fb05-d729-4aae-9ff0-425831b69a31
PRODUCTION_D1_DATABASE_ID=c24822ba-9107-4a97-bab3-0e5ba01bff32
TURNSTILE_SECRET=
TURNSTILE_SECRET_KEY=

# URL da API publicada. Substituir pelo endereço workers.dev confirmado após
# o primeiro deploy; o deploy dos apps web está desativado nesta etapa.
API_URL=http://127.0.0.1:8787

# O web app consome a API e deixa o segredo somente no Worker/.dev.vars.
# Gere um segredo local isolado com: openssl rand -base64 32
BETTER_AUTH_SECRET=troque-por-um-segredo-local-com-32-caracteres
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ASAAS_API_KEY=
ASAAS_API_URL=
ASAAS_WEBHOOK_SECRET=
ASAAS_WALLET_ID=
