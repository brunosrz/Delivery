# Copie para .env.local e preencha com valores do seu ambiente.
# Nunca versione credenciais reais. No CI, o build usa valores dummy.

# Casa das Máquinas (API v1), acessada pelo app web.
# Local: `bun run --filter @delivery/api dev` sobe em http://127.0.0.1:8787.
# Na Vercel, use a URL pública do Worker.
API_URL=https://SEU-WORKER.SUBDOMINIO.workers.dev

# A autenticação vive na Casa das Máquinas (Better Auth). O app web só repassa
# /api/auth/* para ela; o segredo fica em apps/api/.dev.vars.
