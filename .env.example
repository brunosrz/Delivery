# Copie para .env.local e preencha com valores do seu ambiente.
# Nunca versione credenciais reais. No CI, o build usa valores dummy.

# Casa das Máquinas (API v1). Local: `pnpm --filter @delivery/casa-das-maquinas dev` sobe em http://127.0.0.1:8787
CASA_DAS_MAQUINAS_URL=http://127.0.0.1:8787

# Supabase (servidor; usado apenas pela autenticação atual)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase (navegador)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Login com Google (opcional). O provider só é registrado quando as duas
# variáveis abaixo e as credenciais do Supabase no servidor estão preenchidas;
# caso contrário o botão "Google" não aparece na tela de login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
