# Copie para .env.local e preencha com valores do seu ambiente.
# Nunca versione credenciais reais. No CI, o build usa valores dummy.

# Casa das Máquinas (API v1). Local: `pnpm --filter @delivery/casa-das-maquinas dev` sobe em http://127.0.0.1:8787
CASA_DAS_MAQUINAS_URL=http://127.0.0.1:8787

# A autenticação vive na Casa das Máquinas (Better Auth). O app web só repassa
# /api/auth/* para ela; o segredo fica em apps/casa-das-maquinas/.dev.vars.
