# Copie para .env.local e preencha com valores do seu ambiente.
# Nunca versione credenciais reais. No CI, o build usa valores dummy.

# Supabase (servidor)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase (navegador)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Login com Google (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
